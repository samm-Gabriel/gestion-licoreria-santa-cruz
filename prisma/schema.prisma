generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["gestion_licoreria_santa_cruz"]
}

model Producto {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique
  nombre       String
  marca        String?
  categoria    String?
  precioVenta  Decimal       @db.Decimal(10, 2)
  stock        Int           @default(0)
  stockMinimo  Int           @default(5)
  activo       Boolean       @default(true)
  lineasCompra CompraLinea[]
  lineasVenta  VentaLinea[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([nombre])
  @@index([categoria])
  @@schema("gestion_licoreria_santa_cruz")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  nit       String?  @unique
  telefono  String?
  email     String?
  direccion String?
  activo    Boolean  @default(true)
  compras   Compra[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@schema("gestion_licoreria_santa_cruz")
}

model Compra {
  id             Int           @id @default(autoincrement())
  proveedorId    Int
  proveedor      Proveedor     @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  fecha          DateTime      @db.Date
  numeroFactura  String?
  observaciones  String?
  total          Decimal       @db.Decimal(12, 2)
  lineas         CompraLinea[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([fecha])
  @@index([proveedorId])
  @@schema("gestion_licoreria_santa_cruz")
}

model CompraLinea {
  id            Int      @id @default(autoincrement())
  compraId      Int
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad      Int
  costoUnitario Decimal  @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productoId])
  @@schema("gestion_licoreria_santa_cruz")
}

model Venta {
  id        Int          @id @default(autoincrement())
  fecha     DateTime     @default(now())
  total     Decimal      @db.Decimal(12, 2)
  lineas    VentaLinea[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([fecha])
  @@schema("gestion_licoreria_santa_cruz")
}

model VentaLinea {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productoId])
  @@schema("gestion_licoreria_santa_cruz")
}
